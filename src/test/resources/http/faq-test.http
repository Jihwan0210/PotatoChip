Content-Type: application/json

{
  "category": "delivery",
  "question": "배송은 며칠 정도 걸리나요?",
  "answer": "일반 배송은 보통 주문 확인 후 1~3일 정도 소요되며, 산지 출고 상황이나 날씨에 따라 달라질 수 있습니다.",
  "keywords": "배송,도착,택배,출고,소요,며칠",
  "displayOrder": 1
}


